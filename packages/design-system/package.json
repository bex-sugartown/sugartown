{
  "name": "@sugartown/design-system",
  "version": "1.0.0",
  "description": "Sugartown Design System - CMS-agnostic component library",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles/*": "./src/styles/*",
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "dev": "node build.mjs --watch",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@sugartown/eslint-config": "workspace:*",
    "@sugartown/storybook-docs": "workspace:*",
    "@sugartown/tsconfig": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.0",
    "esbuild-css-modules-plugin": "^3.1.5",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.12.0",
    "@types/prismjs": "^1.26.6",
    "lucide-react": "^0.575.0",
    "prismjs": "^1.30.0"
  }
}
