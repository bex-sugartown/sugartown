# Dependencies
**/node_modules
**/dist
**/.turbo
.pnp
.pnp.js

# Build outputs
dist
build
.next
out
storybook-static

# Turbo
.turbo

# Environment
.env
.env.local
.env*.local

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
*.pem

# IDE
.vscode/*
!.vscode/extensions.json
.idea

# Testing
coverage

# Playwright (SUG-240 route smoke tests) — local run artifacts, not committed
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Misc
*.tsbuildinfo
.cache

# Migration artifacts — large export/import files are gitignored
# The artifacts/ directory itself is tracked via artifacts/.gitkeep
# Scripts, manifests, and reports that ARE committed are listed below as exceptions.
artifacts/wp_export.ndjson
artifacts/sanity_import.ndjson
# Keep these — small enough to commit, needed for audit trail:
# artifacts/image_manifest.json      ← commit: maps WP URLs to Sanity asset refs
# artifacts/image_failures.csv       ← commit: audit of failed image transfers
# artifacts/slug_collision_report.csv ← commit: slug resolution audit
# artifacts/parity_report.md         ← commit: cutover validation report
# artifacts/migration_report.json    ← commit: machine-readable parity data
# wp_urls.csv from export-wp-urls.py:
scripts/wp_urls.csv

# Draft documents — local scratchwork, not published to repo
docs/drafts/

# Character study reference images — local only, not committed (binary assets)
docs/brand/character-studies/

# Local Netlify folder
.netlify
apps/storybook/debug-storybook.log

# Build-time generated stats (SUG-67) — regenerated by Vite plugin on every build.
# Written as `/*` rather than `/` so the negation below can take effect: git cannot
# re-include a file whose PARENT DIRECTORY is excluded, only one whose siblings are.
apps/web/src/generated/*

# governance.json (SUG-268 Phase 2) is the exception. It is generated, but by a
# COMMIT-TIME pipeline, not by Vite on every build (Decision 5), so a clean clone
# would otherwise have no file at all — and `validate:governance-diff` compares
# generated bytes against staged/committed bytes, which requires it to be tracked.
!apps/web/src/generated/governance.json

# Build-time generated schema manifest (SUG-114) — regenerated by generate-schema-manifest.mjs on every build
apps/web/src/data/schemaManifest.js
build-storybook.log

# Governance build scratch output (SUG-268) — governance:build writes here so it
# never touches tracked generated files. Phase 2 writes the real outputs instead.
.governance-build/
