#!/bin/sh
# Post-commit hook — mirror every commit to a remote wip/ branch. ST-100 S13.
#
# WHY THIS EXISTS
# Disk safety used to depend on remembering to run /eod. Memory is the thing that
# fails: SUG-231 left 48 commits on one disk for two days, and on 2026-08-18 a
# morning check found 5 more from a session that closed without pushing. This runs
# on its own, so safety stops being a ritual (ST-100 G15).
#
# WHY IT IS FREE
# Nothing observes wip/* branches:
#   · Netlify build_settings.allowed_branches is ['main'] — no build, no deploy.
#     Netlify's credit docs also list branch deploys as not metered, so this is
#     free twice over. A production deploy costs 15 credits; this costs 0.
#   · .github/workflows/ci.yml triggers on `branches: [main]` and PRs to main only.
# Verified 2026-08-18. If either changes, re-check before assuming this is free.
#
# WHY force-with-lease
# wip/<date>-<branch> is a moving mirror of that branch, and a rebase rewrites it. --force-with-lease
# refuses if the remote moved unexpectedly. This namespace is written only by this
# hook; it is never a source of truth and is safe to discard.
#
# WHY THE FETCH IS FORCED (`+`)
# Two machines mirror the same flat ref when both commit on one branch on one day. When the
# other machine moved the ref to a commit this clone lacks, an unforced fetch refuses the
# non-fast-forward update, the lease base stays stale, and every push fails "stale info"
# (#215, 2026-11-08: three FAILs running). The forced fetch keeps the base current. Accepted
# cost (#215 design a): the later writer replaces the earlier machine's mirror until that
# machine commits again.
#
# RECOVERY
# After a FAIL, rerun this hook in the foreground; it is the one copy of the mirror logic:
#   ST_MIRROR_SYNC=1 sh .husky/post-commit; tail -1 .git/st-mirror.log
#
# WHY ONE REF PER BRANCH PER DAY
# A single wip/<date> ref mirrored only the branch committed on last: committing on main after a
# feature branch (or the reverse) overwrote the other branch's commits in the mirror, leaving them
# on this disk only. Seen live 2026-09-03 by /sweep's per-branch containment check. ST-115.
# Slashes in a branch name become dashes (feat/x -> feat-x). The ref is wip/<date>-<branch>, flat,
# not wip/<date>/<branch>: git cannot create a ref under a name that already exists as a leaf, and
# a machine still running the older hook creates the flat wip/<date> leaf first (seen live
# 2026-09-04, first push of this shape rejected with 'cannot lock ref').
#
# HOW HUSKY RUNS THIS
# .husky/_/h invokes every hook as `sh -e`, so any command that exits non-zero
# outside a conditional kills the script — including inside the backgrounded
# subshell below. Anything here that may legitimately fail carries `|| true`.
# ST-113 was this exact omission.

[ -n "$ST_NO_MIRROR" ] && exit 0
# #142: a branch already under wip/ is a mirror, not a source. Committing on one (a cloud
# session started from wip/<date>-main) would otherwise mirror it to wip/<date>-wip-<date>-main.
case "$(git branch --show-current 2>/dev/null)" in wip/*) exit 0 ;; esac
git remote get-url origin >/dev/null 2>&1 || exit 0

# ST-109: during a rebase every replayed commit fires this hook in the same second, and N
# backgrounded pushes race one ref; the losers write FAIL for a mirror that is actually fine.
# Skip while a rebase is in progress. .husky/post-rewrite mirrors once when it finishes and
# sets ST_MIRROR_AFTER_REWRITE so this guard lets it through (the rebase state directory may
# still exist at that moment).
if [ -z "$ST_MIRROR_AFTER_REWRITE" ]; then
  GITDIR=$(git rev-parse --git-dir)
  if [ -d "$GITDIR/rebase-merge" ] || [ -d "$GITDIR/rebase-apply" ]; then
    exit 0
  fi
fi

LOG=".git/st-mirror.log"

# Read the previous attempt before starting a new one. The log's reader is the next
# run of this hook — without it a silently failing mirror gives false confidence,
# which is worse than no mirror at all (CLAUDE.md §Building a mechanism, rule 1:
# name the reader before building the writer).
if [ -f "$LOG" ] && grep -q '^FAIL' "$LOG" 2>/dev/null; then
  echo "⚠️   wip mirror: last push failed — $(tail -1 "$LOG")"
  echo "    Commits may exist only on this disk. This commit's mirror is retrying now."
  echo "    To retry by hand and see the result:"
  echo "    ST_MIRROR_SYNC=1 sh .husky/post-commit; tail -1 .git/st-mirror.log"
fi

CUR=$(git branch --show-current 2>/dev/null | tr / -); [ -n "$CUR" ] || CUR=detached
BRANCH="wip/$(date +%Y-%m-%d)-$CUR"
SHA=$(git rev-parse --short HEAD)
# Push this exact commit, not HEAD: the push below runs in the background, and a git switch
# right after the commit would otherwise push the other branch and log OK for a commit that
# never left the disk (ST-114, seen live 2026-09-03). A raw SHA source also skips the
# --force-if-includes reflog check, which only applies to local branches; fine for a mirror.
FULL=$(git rev-parse HEAD)

# Backgrounded so committing stays fast. Detached from the terminal so husky does
# not wait on it. ST_MIRROR_SYNC=1 runs it in the foreground (the recovery command above).
mirror() (
  # Refresh the remote-tracking ref before pushing. --force-with-lease compares against it,
  # and when it is absent or stale git refuses with "stale info". That happens whenever
  # another actor (a second machine, or the stats bot) advanced this ref first, which is
  # exactly the multi-machine case this hook exists to cover. ST-106.
  #
  # On the first commit of a day the branch does not exist remotely yet and this fetch
  # exits 128. Under `sh -e` that used to kill this subshell before the push and before
  # the log line, so every day's first commit went unmirrored and unrecorded. The
  # `|| true` is what makes the miss harmless. ST-113.
  #
  # The leading `+` lets the tracking ref follow a non-fast-forward move by another
  # writer (#215); see WHY THE FETCH IS FORCED above.
  git fetch --quiet origin "+refs/heads/${BRANCH}:refs/remotes/origin/${BRANCH}" 2>/dev/null || true
  if git push --force-with-lease --quiet origin "$FULL:refs/heads/$BRANCH" 2>/dev/null; then
    echo "OK   $(date +%Y-%m-%dT%H:%M:%S) $SHA -> $BRANCH" > "$LOG"
  else
    echo "FAIL $(date +%Y-%m-%dT%H:%M:%S) $SHA -> $BRANCH" > "$LOG"
  fi
)

if [ -n "$ST_MIRROR_SYNC" ]; then
  mirror || true
else
  mirror >/dev/null 2>&1 &
fi

exit 0
