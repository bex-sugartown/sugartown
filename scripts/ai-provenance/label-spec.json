{
  "_comment": "Single source for the baked AI mark. AiLabel.module.css repeats these values; test_stamp.py fails when the two disagree. Vspec: docs/drafts/ST-178-ai-image-provenance-metadata-and-watermark.vspec.html",
  "anchorPct": 3,
  "sizePct": 3.2,
  "capPx": 14,
  "minWidthShort": 96,
  "minWidthFull": 200,
  "padYEm": 0.35,
  "padXEm": 0.6,
  "trackingEm": 0.1,
  "borderPx": 1,
  "textShort": "AI",
  "textFull": "AI-generated",
  "renditionWidths": [480, 960, 1920],
  "jpegQuality": 85,
  "digitalSourceType": "http://cv.iptc.org/newscodes/digitalsourcetype/trainedAlgorithmicMedia",
  "tokens": {
    "fill": "--st-color-midnight-950",
    "text": "--st-color-white",
    "border": "--st-chip-border"
  },
  "fonts": [
    "/System/Library/Fonts/Menlo.ttc",
    "/System/Library/Fonts/Supplemental/Courier New Bold.ttf"
  ]
}
