# Local overrides — copy to .env.local and fill in values.
# .env.local is gitignored and never committed.
#
# CI-only collectors: without these keys, the stats pipeline reuses
# the last cached data from stats.json on each Vite restart rather
# than making a failed network call. Add them here to collect live data locally.

# Linear read-only personal token (scoped to Issues).
# Without this, stats.linearRoadmap uses cached data from the last CI run.
# Get one at: https://linear.app/settings/api → Personal API keys
LINEAR_API_KEY=

# GitHub personal token (public_repo scope).
# Without this, stats.github uses cached data.
GITHUB_TOKEN=
