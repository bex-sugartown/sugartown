#!/bin/sh
# Pre-commit hook — fast, local CSS validators only
# Validators that require Sanity API (validate:urls, validate:content) run manually pre-PR.

# Block direct edits to generated tokens.css files — edit tokens/source/tokens.json and run pnpm tokens:build
# Exception: allow when the JSON source is also staged (legitimate regeneration)
STAGED=$(git diff --cached --name-only)
if ! echo "$STAGED" | grep -qF "tokens/source/tokens.json"; then
  for f in "apps/web/src/design-system/styles/tokens.css" "packages/design-system/src/styles/tokens.css"; do
    if echo "$STAGED" | grep -qF "$f"; then
      HEAD_HEADER=$(git show HEAD:"$f" 2>/dev/null | head -3 || true)
      if echo "$HEAD_HEADER" | grep -q "Do not edit directly"; then
        echo "❌  $f is generated — edit tokens/source/tokens.json and run pnpm tokens:build instead"
        exit 1
      fi
    fi
  done
fi

# Token reference check — every var(--st-*) must resolve to a defined token
pnpm --filter web validate:tokens || exit 1

# Style-mirror parity — the duplicated DS style files (tokens.css, theme.*.css,
# globals, utilities) must be byte-identical across web ↔ DS package.
# Catches theme-file drift that validate:tokens cannot (refs resolve ≠ themes match).
pnpm --filter web validate:style-mirror || exit 1

# Raw value lint — no hardcoded hex/rgba in component CSS files
pnpm --filter web validate:tokens:strict || exit 1

# Dead-reference check — styles.X with no matching class, and destructured props
# never referenced. Both are invisible to lint/TS/Chromatic: valid code, stable
# output, silently doing nothing. Caught Table's styles.wide and FilterBar's
# onClearAll after each had shipped. SUG-231 post-mortem.
pnpm --filter web validate:dead-refs || exit 1

# CSS class naming — blocks content-type- or call-site-scoped class names
# (tax*, tag*, term*, etc.) in apps/web/src/pages/. Built by SUG-124, ran
# silently unenforced (no hook, no CI job) until SUG-239 wired it up here.
pnpm --filter web validate:css-names || exit 1

# Generated governance artifact must still correspond to its source. Compares
# against the INDEX, not the worktree: rebuilding from the worktree and comparing
# against staged bytes passes when the generated file is staged and its source is
# not, committing output that does not match committed source (SUG-268 Ph2, B3).
# Regeneration goes to a scratch dir; this never writes a tracked file.
pnpm validate:governance-diff || exit 1

# Governance source: schema, closed-world referential integrity, overdue reads,
# and a scan for governance data authored outside governance/source/. Reads the
# INDEX, so it gates the staged state rather than whatever the worktree holds.
# --reference-date pins the not-in-the-future comparison to today: HEAD is the
# PARENT commit during a pre-commit hook, so a record dated today would fail
# against yesterday's committer date (SUG-268 Phase 1 findings ledger).
pnpm validate:governance --reference-date "$(date -u +%Y-%m-%d)" || exit 1

# Every validate:* script must be wired into a hook or CI job, or explicitly
# allowlisted as manual-by-design. Prevents this exact class of silent decay.
pnpm validate:validators || exit 1

# ESLint — zero errors required (warnings are allowed), across EVERY package.
#
# This was `pnpm --filter web lint` until SUG-255. That narrowing is the exact
# visibility gap that let lint regressions in packages/design-system,
# apps/storybook and apps/contentful-poc accumulate to 84 errors while every
# local commit passed: the hook only ever looked at one of five packages, and CI
# — the only thing that looked at the rest — had been red since 2026-05-10 with
# nobody reading it. A gate that inspects a fifth of the repo reports on a fifth
# of the repo. `pnpm lint` is turbo-cached and costs ~4s warm.
pnpm lint || exit 1
