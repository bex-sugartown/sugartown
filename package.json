{
  "name": "sugartown-monorepo",
  "version": "0.32.0",
  "private": true,
  "type": "module",
  "description": "Sugartown.io mini-monorepo: composable MACH reference architecture",
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev --filter=web --filter=studio",
    "build": "turbo run build --continue",
    "lint": "turbo run lint --continue",
    "lint:css": "stylelint \"**/*.css\" --ignore-path .gitignore",
    "typecheck": "turbo run typecheck --continue",
    "test:smoke": "playwright test",
    "validate:urls": "pnpm --filter web validate:urls",
    "validate:filters": "pnpm --filter web validate:filters",
    "validate:content": "pnpm --filter web validate:content",
    "validate:schema-parity": "pnpm --filter studio validate:schema-parity",
    "tokens:build": "node sd.config.mjs",
    "tokens:migrate": "node tokens/scripts/migrate-css-to-json.mjs",
    "validate:tokens": "pnpm --filter web validate:tokens",
    "validate:tokens:strict": "pnpm --filter web validate:tokens:strict",
    "validate:style-mirror": "pnpm --filter web validate:style-mirror",
    "validate:taxonomy": "pnpm --filter web validate:taxonomy",
    "validate:validators": "node scripts/validate-validators.js",
    "validate:enforcement-liveness": "node scripts/validate-enforcement-liveness.js",
    "validate:controls": "node scripts/validate-control-register.js",
    "validate:doc-budget": "node scripts/validate-doc-budget.js",
    "validate:governance-tally": "node scripts/validate-governance-tally.js",
    "validate:epic-docs": "node scripts/validate-epic-docs.js",
    "collect:evidence-digest": "node scripts/monthly-evidence-digest.js",
    "registry:build": "node scripts/registry-build.js",
    "governance:build": "node scripts/governance-build.js",
    "migrate:taxonomy": "node scripts/migrate-taxonomy.js",
    "storybook": "turbo run storybook",
    "storybook:build": "turbo run storybook:build",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "migrate:card-section": "node scripts/migrate/statTileSection-to-cardSection.js",
    "migrate:export": "node scripts/migrate/export.js",
    "migrate:images": "node scripts/migrate/images.js",
    "migrate:transform": "node scripts/migrate/transform.js",
    "migrate:import": "node scripts/migrate/import.js",
    "migrate:redirects": "node scripts/migrate/redirects.js",
    "migrate:parity": "node scripts/migrate/parity.js",
    "migrate:featured-to-hero": "node scripts/migrate/featured-to-hero.js",
    "migrate:backfill-html-section": "node scripts/migrate/backfill-html-section.js",
    "migrate:cleanup-tags": "node scripts/migrate/cleanup-tag-tool-duplicates.js",
    "migrate:cleanup-orphan-tags": "node scripts/migrate/cleanup-orphan-tags.js",
    "migrate:backfill-author": "node scripts/migrate/backfill-default-author.js",
    "migrate:rename-images": "node scripts/migrate/rename-images.js",
    "migrate:html-tables": "node scripts/migrate/html-tables-to-tableblock.js",
    "audit:urls": "node scripts/audit/wp-url-spider.js",
    "bulk:export": "node scripts/bulk/export-csv.js",
    "bulk:import": "node scripts/bulk/import-csv.js",
    "generate:schema-manifest": "node scripts/generate-schema-manifest.mjs",
    "mttn": "node scripts/mttn.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "husky": "^9.0.0",
    "linkedom": "^0.18.12",
    "prettier": "^3.1.1",
    "stylelint": "^17.3.0",
    "stylelint-config-standard": "^40.0.0",
    "turbo": "^1.11.3",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@sanity/client": "^7.14.1",
    "style-dictionary": "^5.4.0"
  }
}
