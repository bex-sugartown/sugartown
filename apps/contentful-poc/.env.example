# Contentful Content Delivery API (Phase 1 — reads published content)
# Get these from Contentful: Settings → API keys → (your API key)
# Copy this file to .env.local and fill in the values. .env.local is gitignored.
# No NEXT_PUBLIC_ prefix: these stay server-side and never reach the browser.

CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_ENVIRONMENT=master

# Content Management API token — only needed for migration scripts (scripts/sug-188-*.mjs etc.)
# Get from: Contentful → Settings → API keys → Content Management Tokens
# Never use this token in app code — it has write access.
CONTENTFUL_MANAGEMENT_TOKEN=
